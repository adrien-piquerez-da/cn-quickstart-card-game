module CardGame.Scripts.TestCardGame where

import CardGame

import DA.Action (foldlA)
import Daml.Script

createGame gamemaster players = script do
  lobby0 <- submit gamemaster do
    createCmd GameLobby with
      gamemaster
      players = []
      invitees = players
  lobby1 <- foldlA (\lobby player -> submit player do exerciseCmd lobby JoinGame { player }) lobby0 players
  submit gamemaster do exerciseCmd lobby1 StartGame { seed = 1 }

queryCardInHand player card = script do
  [(cardInHand, _)] <- queryFilter @CardInHand player (\cardInHand -> cardInHand.card == card)
  return cardInHand

-- TESTS --

draw_cards = script do
  gamemaster <- allocateParty "gamemaster"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  (deck, _) <- createGame gamemaster [alice, bob]
  submitMustFail bob do exerciseCmd deck (DrawCard alice)
  submit bob do exerciseCmd deck (DrawCard bob)

